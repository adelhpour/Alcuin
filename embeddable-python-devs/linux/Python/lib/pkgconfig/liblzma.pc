prefix=/home/thonny/pythonny310
exec_prefix=/home/thonny/pythonny310
libdir=/home/thonny/pythonny310/lib
includedir=/home/thonny/pythonny310/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.2.11
Cflags: -I${includedir}
Libs: -L${libdir} -llzma
Libs.private: -pthread -lpthread
